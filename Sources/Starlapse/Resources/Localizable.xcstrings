    "Light per frame": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الضوء لكل إطار"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht pro Bild"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz por cuadro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumière par image"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति फ़्रेम प्रकाश"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luce per fotogramma"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1フレームの光"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kare başına ışık"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单帧进光"
          }
        }
      }
    },
    "Light per frame exceeds the interval — frames would overlap.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الضوء لكل إطار يتجاوز الفاصل — ستتداخل الإطارات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht pro Bild übersteigt das Intervall — Bilder würden sich überlappen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz por cuadro supera el intervalo: los fotogramas se superpondrían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière par image dépasse l'intervalle — les images se chevaucheraient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति फ़्रेम प्रकाश अंतराल से अधिक है — फ़्रेम ओवरलैप होंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce per fotogramma supera l'intervallo: i fotogrammi si sovrapporrebbero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1フレームの露光が間隔を超えています — フレームが重なります。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kare başına ışık aralığı aşıyor: kareler çakışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单帧进光时间超过间隔 — 帧会重叠。"
          }
        }
      }
    },
    "Long frames blur the meteor into the background between exposures.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإطارات الطويلة تُذيب الشهاب في الخلفية بين التعريضات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange Bilder verwischen den Meteor zwischen den Belichtungen in den Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cuadros largos difuminan el meteoro en el fondo entre exposiciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les poses longues fondent le météore dans le fond entre deux expositions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबे फ़्रेम एक्सपोज़र के बीच उल्का को पृष्ठभूमि में धुँधला कर देते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogrammi lunghi confondono la meteora nello sfondo tra un'esposizione e l'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長いフレームでは露光の合間に流星が背景に溶け込みます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun kareler, pozlamalar arasında meteoru arka plana karıştırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单帧过长，流星会在曝光间隙被模糊进背景。"
          }
        }
      }
    },
