    "Moon %d%% up on every dark night of the window.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القمر %d%% فوق الأفق في كل ليلة مظلمة من النافذة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mond zu %d%% am Himmel in jeder dunklen Nacht des Zeitraums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna al %d%% en el cielo todas las noches oscuras de la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lune à %d%% levée chaque nuit sombre de la fenêtre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विंडो की हर अँधेरी रात में चंद्रमा %d%% ऊपर रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna al %d%% in cielo in ogni notte scura della finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間中のすべての暗夜で月（%d%%）が出ています。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencerenin her karanlık gecesinde Ay %%%d ve ufkun üstünde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口内的每个黑夜月亮都在天上，亮度%d%%。"
          }
        }
      }
    },
