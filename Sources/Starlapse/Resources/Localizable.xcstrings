    "Under 2 seconds of video. Shorten the interval or shoot longer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقل من ثانيتين من الفيديو. قصّر الفاصل أو صوّر لفترة أطول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter 2 Sekunden Video. Intervall verkürzen oder länger aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de 2 segundos de video. Acorta el intervalo o graba más tiempo."
          }
