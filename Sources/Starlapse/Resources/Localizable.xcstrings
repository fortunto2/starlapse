    "Comets, conjunctions, eclipses, dark frames: added to Pro, never charged again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المذنّبات والاقترانات والكسوف والإطارات المظلمة: تُضاف إلى Pro دون أي رسوم إضافية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kometen, Konjunktionen, Finsternisse, Dunkelbilder: kommen zu Pro dazu, ohne neue Kosten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cometas, conjunciones, eclipses, tomas oscuras: se añaden a Pro sin volver a cobrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comètes, conjonctions, éclipses, darks : ajoutés à Pro, jamais facturés à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धूमकेतु, युति, ग्रहण, डार्क फ़्रेम: Pro में जोड़े जाएँगे, दोबारा शुल्क नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comete, congiunzioni, eclissi, dark frame: aggiunti a Pro, senza mai pagare di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彗星、惑星の接近、食、ダークフレーム：Proに追加、追加課金なし。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyruklu yıldızlar, kavuşumlar, tutulmalar, karanlık kareler: Pro'ya eklenir, bir daha ücret alınmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "彗星、行星合、日月食、暗场：加入Pro，永不再收费。"
          }
        }
      }
    },
