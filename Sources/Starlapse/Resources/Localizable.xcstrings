    "No shower has a dark night here in the next 90 days.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا زخة لها ليلة مظلمة هنا خلال الـ 90 يومًا القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Strom hat hier in den nächsten 90 Tagen eine dunkle Nacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna lluvia tiene una noche oscura aquí en los próximos 90 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune pluie n'a de nuit sombre ici dans les 90 prochains jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले 90 दिनों में यहाँ किसी उल्का वर्षा को अँधेरी रात नहीं मिलती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno sciame ha una notte scura qui nei prossimi 90 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後90日間、この場所で暗夜に当たる流星群はありません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önümüzdeki 90 günde burada karanlık gecesi olan yağmur yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来90天内，此地没有流星雨能遇上合适的黑夜。"
          }
        }
      }
    },
    "No stars to focus on. Point at open sky, or wait for cloud to pass.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا نجوم للتركيز عليها. وجّه نحو سماء مكشوفة، أو انتظر مرور الغيوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Sterne zum Fokussieren. Auf freien Himmel richten oder warten, bis die Wolken ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay estrellas para enfocar. Apunta al cielo despejado o espera a que pasen las nubes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune étoile pour le point. Viser le ciel dégagé, ou attendre que les nuages passent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोकस के लिए तारे नहीं। खुले आकाश की ओर करें, या बादल हटने की प्रतीक्षा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna stella su cui mettere a fuoco. Punta verso il cielo aperto o aspetta che passino le nuvole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスできる星がありません。開けた空に向けるか、雲が過ぎるのを待ってください。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklanacak yıldız yok. Açık gökyüzüne yöneltin veya bulutun geçmesini bekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可对焦的星。请对准开阔天空，或等云散去。"
          }
        }
      }
    },
