    "Stepping the lens and measuring star size.\nHold still — the tripod must not move.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحريك العدسة تدريجيًا وقياس حجم النجوم.\nلا تتحرك — يجب ألا يتحرك الحامل الثلاثي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objektiv wird schrittweise verstellt, Sterngröße gemessen.\nStill halten — das Stativ darf sich nicht bewegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moviendo el objetivo por pasos y midiendo el tamaño de las estrellas.\nQuieto: el trípode no debe moverse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacement de l'objectif et mesure des étoiles.\nNe pas bouger — le trépied doit rester immobile."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेंस को चरणों में घुमाकर तारों का आकार माप रहे हैं।\nस्थिर रखें — ट्राइपॉड हिलना नहीं चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposto l'obiettivo a passi e misuro la dimensione delle stelle.\nFermo: il treppiede non deve muoversi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズを段階的に動かし星の大きさを測定中。\n動かさないで — 三脚を固定したまま。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lens adım adım kaydırılıp yıldız boyutu ölçülüyor.\nSabit durun: tripod oynamamalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐步调整镜头并测量星点大小。\n保持静止 — 三脚架不可移动。"
          }
        }
      }
    },
