    "~%.1f/h at best from here. Not worth a night.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحو %.1f/ساعة على الأكثر من هنا. لا يستحق ليلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens ~%.1f/h von hier. Keine Nacht wert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como mucho ~%.1f/h desde aquí. No vale una noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "~%.1f/h au mieux d'ici. Ça ne vaut pas une nuit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ से ज़्यादा से ज़्यादा ~%.1f/घंटा। रात खर्च करने लायक नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo ~%.1f/h da qui. Non vale una notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは最大でも約%.1f個/時。夜を費やす価値はありません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradan en fazla ~%.1f/sa. Bir geceye değmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此地最多约 %.1f 颗/小时，不值得熬夜。"
