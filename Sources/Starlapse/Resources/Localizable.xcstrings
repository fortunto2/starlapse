    "Clip under a second. Lengthen the windows or lower the output frame rate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المقطع أقل من ثانية. أطِل النوافذ أو اخفض معدل إطارات الإخراج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clip unter einer Sekunde. Fenster verlängern oder Ausgabe-Bildrate senken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clip de menos de un segundo. Alarga las ventanas o baja la tasa de fotogramas de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clip sous une seconde. Allonger les fenêtres ou réduire la cadence de sortie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिप एक सेकंड से छोटी। विंडो बढ़ाएँ या आउटपुट फ़्रेम दर घटाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clip sotto il secondo. Allunga le finestre o riduci il frame rate di uscita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップが1秒未満。ウィンドウを延ばすか出力フレームレートを下げてください。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip bir saniyenin altında. Pencereleri uzatın veya çıkış kare hızını düşürün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "片段不足一秒。请加长时间窗或降低输出帧率。"
          }
        }
      }
    },
