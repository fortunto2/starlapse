    "%.1f stops darker than %@ — you cannot open this up, only pick a faster lens.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغمق بـ %.1f درجة ضوئية من %@ — لا يمكن فتح الفتحة أكثر، فقط اختيار عدسة أسرع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f Blenden dunkler als %@ — weiter öffnen geht nicht, nur ein lichtstärkeres Objektiv wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f pasos más oscuro que %@: no se puede abrir el diafragma, solo elegir un objetivo más luminoso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f IL plus sombre que %@ — impossible d'ouvrir davantage, seulement choisir un objectif plus lumineux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ से %1$.1f स्टॉप गहरा — अपर्चर खोला नहीं जा सकता, केवल तेज़ लेंस चुन सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f stop più scuro di %@: non si può aprire il diaframma, solo scegliere un obiettivo più luminoso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@より%1$.1f段暗い。絞りは開けられず、より明るいレンズを選ぶのみ。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ lensine göre %1$.1f stop daha karanlık: diyafram açılamaz, yalnızca daha hızlı bir lens seçilebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比%2$@暗%1$.1f档。光圈无法调大，只能换更快的镜头。"
          }
        }
      }
    },
