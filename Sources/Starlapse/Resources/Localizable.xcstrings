    "Tonight's events and where to aim for them. One purchase, no subscription.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحداث هذه الليلة وأين توجّه نحوها. شراء واحد، بلا اشتراك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ereignisse heute Nacht und wohin dafür zielen. Ein Kauf, kein Abo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos de esta noche y dónde apuntar para verlos. Una sola compra, sin suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements de ce soir et où viser. Un seul achat, sans abonnement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज रात की घटनाएँ और उनके लिए कहाँ निशाना लगाएँ। एक ख़रीद, कोई सब्सक्रिप्शन नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
