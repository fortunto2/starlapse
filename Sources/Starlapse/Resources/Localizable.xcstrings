    "Active meteor showers with the expected rate, every night of the year.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زخات الشهب النشطة مع المعدل المتوقع، كل ليلة من السنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive Meteorströme mit der erwarteten Rate, jede Nacht des Jahres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las lluvias de meteoros activas con su tasa esperada, cada noche del año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pluies de météores actives et leur taux attendu, chaque nuit de l'année."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साल की हर रात सक्रिय उल्का वर्षा और उनकी अपेक्षित दर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli sciami meteorici attivi con la frequenza prevista, ogni notte dell'anno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "活動中の流星群と予想出現数、一年中毎晩。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yılın her gecesi, beklenen oranıyla aktif meteor yağmurları."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全年每晚的活跃流星雨及预期流量。"
          }
        }
      }
    },
