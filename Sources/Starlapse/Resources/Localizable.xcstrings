    "KEEP THE APP OPEN — iOS STOPS THE CAMERA IN THE BACKGROUND": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ التطبيق مفتوحًا — iOS يوقف الكاميرا في الخلفية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "APP OFFEN LASSEN — iOS STOPPT DIE KAMERA IM HINTERGRUND"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MANTÉN LA APP ABIERTA — iOS DETIENE LA CÁMARA EN SEGUNDO PLANO"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GARDER L'APP OUVERTE — iOS COUPE LA CAMÉRA EN ARRIÈRE-PLAN"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप खुला रखें — iOS बैकग्राउंड में कैमरा रोक देता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TIENI L'APP APERTA — iOS FERMA LA FOTOCAMERA IN BACKGROUND"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開いたままに — iOSはバックグラウンドでカメラを停止します"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UYGULAMAYI AÇIK TUTUN — iOS ARKA PLANDA KAMERAYI DURDURUR"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持应用在前台 — iOS会在后台停止相机"
          }
        }
      }
