    "Watches for meteors and saves a clip around each one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يراقب الشهب ويحفظ مقطعًا حول كل منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf Meteore und sichert um jeden einen Clip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vigila el cielo en busca de meteoros y guarda un clip de cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Guette les météores et enregistre un clip autour de chacun."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उल्काओं पर नज़र रखता है और हर एक के आसपास की क्लिप सहेजता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osserva il cielo in cerca di meteore e salva una clip attorno a ciascuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "流星を監視し、それぞれの前後をクリップとして保存。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteorları gözler ve her birinin etrafında bir klip kaydeder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监视流星，并为每颗保存一段片段。"
          }
        }
      }
    },
    "When each shower peaks, and the Moon-free window around it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى تبلغ كل زخة ذروتها، والنافذة الخالية من القمر حولها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann jeder Strom sein Maximum hat, und das mondfreie Fenster darum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo alcanza su pico cada lluvia, y la ventana sin Luna a su alrededor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pic de chaque pluie, et la fenêtre sans Lune autour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर उल्का वर्षा का चरम कब है, और उसके आसपास चंद्रमा-रहित समय।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ogni sciame raggiunge il picco, e la finestra senza Luna intorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各流星群の極大時刻と、その前後の月のない時間帯。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yağmurun ne zaman zirve yaptığı ve etrafındaki Ay'sız pencere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每场流星雨的极大时间及其周围的无月窗口。"
          }
        }
      }
    },
