        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄时长"
          }
        }
      }
    },
    "Sky moves %.1f° between frames — motion will look steppy.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحرك السماء %.1f° بين الإطارات — ستبدو الحركة متقطعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Himmel bewegt sich %.1f° zwischen den Bildern — Bewegung wirkt ruckelig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo se mueve %.1f° entre cuadros: el movimiento se verá a saltos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ciel tourne de %.1f° entre deux images — le mouvement sera saccadé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्रेमों के बीच आकाश %.1f° खिसकता है — गति झटकेदार दिखेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cielo si sposta di %.1f° tra i fotogrammi: il movimento risulterà a scatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーム間で空が%.1f°動きます — 動きがカクつきます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gökyüzü kareler arasında %.1f° kayıyor: hareket kesik görünecek."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帧间天空移动%.1f° — 动态会显得跳跃。"
          }
        }
      }
    },
