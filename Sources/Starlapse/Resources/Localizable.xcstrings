        }
      }
    },
    "The purchase goes to Apple. Starlapse sends nothing else, except a usage counter you can switch off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشراء يتم عبر Apple. لا يرسل Starlapse شيئًا آخر، سوى عدّاد استخدام يمكن إيقافه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf läuft über Apple. Starlapse sendet sonst nichts, außer einem abschaltbaren Nutzungszähler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra va a Apple. Starlapse no envía nada más, salvo un contador de uso que puedes desactivar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat passe par Apple. Starlapse n'envoie rien d'autre, sauf un compteur d'utilisation désactivable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ख़रीद Apple के पास जाती है। Starlapse और कुछ नहीं भेजता, सिवाय एक उपयोग काउंटर के जिसे आप बंद कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto va ad Apple. Starlapse non invia altro, tranne un contatore d'uso che puoi disattivare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入はAppleが処理します。Starlapseはオフにできる使用カウンター以外、何も送信しません。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma Apple'a gider. Starlapse, kapatabileceğiniz bir kullanım sayacı dışında başka hiçbir şey göndermez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买由Apple处理。Starlapse不发送其他数据，仅有一个可关闭的使用计数器。"
          }
        }
      }
    },
    "The target 40° off the radiant and clear of the Moon, with the arrow to it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الهدف على بُعد 40° من نقطة الإشعاع وبعيدًا عن القمر، مع سهم يشير إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel 40° vom Radianten entfernt und frei vom Mond, mit dem Pfeil dorthin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo a 40° del radiante y lejos de la Luna, con la flecha que lo señala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La cible à 40° du radiant et loin de la Lune, avec la flèche pour y aller."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेडियंट से 40° दूर और चंद्रमा से हटकर लक्ष्य, उस तक तीर के साथ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bersaglio a 40° dal radiante e lontano dalla Luna, con la freccia che lo indica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "放射点から40°離れ月を避けた目標と、そこへの矢印。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radyanttan 40° ötede ve Ay'dan uzak hedef, ona götüren okla birlikte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标位于放射点40°外并避开月亮，箭头指向它。"
          }
        }
      }
    },
    "This sensor caps a single frame at %.2fs — longer exposures are stacked, not held.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدّ هذا المستشعر الإطار الواحد بـ %.2fs — التعريضات الأطول تُكدَّس ولا تُمدَّد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Sensor begrenzt ein Einzelbild auf %.2fs — längere Belichtungen werden gestapelt, nicht gehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este sensor limita cada cuadro a %.2fs: las exposiciones más largas se apilan, no se mantienen abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce capteur limite une image à %.2fs — au-delà, les expositions sont empilées, pas prolongées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सेंसर एक फ़्रेम को %.2fs तक सीमित रखता है — लंबे एक्सपोज़र स्टैक होते हैं, खुले नहीं रहते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo sensore limita il singolo fotogramma a %.2fs: le esposizioni più lunghe vengono impilate, non tenute aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセンサーの1フレーム上限は%.2fs — それ以上の露光はスタックで実現します。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sensör tek kareyi %.2fs ile sınırlar: daha uzun pozlamalar tutulmaz, yığınlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此传感器单帧上限为%.2fs — 更长曝光通过叠加实现，而非持续曝光。"
          }
        }
      }
    },
