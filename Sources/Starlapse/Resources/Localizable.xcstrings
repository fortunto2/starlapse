    "Brightest pixel wins. The sky's rotation draws arcs, the ground stays sharp.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البكسل الأسطع يفوز. دوران السماء يرسم أقواسًا، والأرض تبقى حادة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hellstes Pixel gewinnt. Die Himmelsdrehung zeichnet Bögen, der Boden bleibt scharf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana el píxel más brillante. La rotación del cielo dibuja arcos, el suelo queda nítido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pixel le plus clair gagne. La rotation du ciel trace des arcs, le sol reste net."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे चमकीला पिक्सेल रहता है। आकाश का घूर्णन चाप बनाता है, ज़मीन तीखी रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vince il pixel più luminoso. La rotazione del cielo disegna archi, il suolo resta nitido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も明るい画素を採用。空の回転が弧を描き、地上はシャープなまま。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En parlak piksel kazanır. Gökyüzünün dönüşü yaylar çizer, zemin net kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取最亮像素。天空旋转画出弧线，地面保持清晰。"
          }
        }
      }
    },
