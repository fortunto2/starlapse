    "Meteor showers in the next 90 days, with the night and hour that work from here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زخات الشهب في الـ 90 يومًا القادمة، مع الليلة والساعة المناسبتين من هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meteorströme der nächsten 90 Tage, mit der Nacht und Stunde, die von hier aus passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lluvias de meteoros de los próximos 90 días, con la noche y la hora que funcionan desde aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pluies de météores des 90 prochains jours, avec la nuit et l'heure qui conviennent d'ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले 90 दिनों की उल्का वर्षा, उस रात और घंटे के साथ जो यहाँ से काम करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli sciami meteorici dei prossimi 90 giorni, con la notte e l'ora che funzionano da qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後90日間の流星群と、この場所で見頃となる夜と時刻。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önümüzdeki 90 günün meteor yağmurları, buradan işe yarayan gece ve saatle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来90天的流星雨，以及在此地适合观测的夜晚与时刻。"
          }
        }
      }
    },
