    "The App Store is not reachable right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الوصول إلى App Store الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store ist gerade nicht erreichbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no está disponible en este momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store est inaccessible pour le moment."
          }
        },
        "hi": {
