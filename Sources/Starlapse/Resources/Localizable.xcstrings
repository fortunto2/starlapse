    "Averaged as shot. Stars trail a little, the landscape gets very clean.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوسط كما صُوّر. النجوم تنجرّ قليلًا، والمنظر الطبيعي يصبح نقيًا جدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemittelt wie aufgenommen. Sterne ziehen leicht, die Landschaft wird sehr sauber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Promedio sin alinear. Las estrellas dejan una leve traza, el paisaje queda muy limpio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyenne sans alignement. Les étoiles filent un peu, le paysage devient très propre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसा शूट हुआ, औसत। तारे थोड़े खिंचते हैं, लैंडस्केप बहुत साफ़ होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Media senza allineamento. Le stelle lasciano una piccola scia, il paesaggio diventa molto pulito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影そのまま平均。星は少し流れ、風景は非常にクリーンに。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizalanmadan ortalanır. Yıldızlar hafif iz bırakır, manzara çok temiz çıkar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按原样平均。星点略有拖尾，地景非常干净。"
          }
        }
      }
    },
