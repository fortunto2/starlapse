    "Frames aligned on the stars, then averaged. Stars stay sharp, noise drops as √N.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إطارات محاذاة على النجوم ثم متوسطة. النجوم تبقى حادة، والتشويش ينخفض بنسبة √N."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder an den Sternen ausgerichtet, dann gemittelt. Sterne bleiben scharf, Rauschen sinkt mit √N."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogramas alineados por las estrellas y luego promediados. Las estrellas quedan nítidas, el ruido baja como √N."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images alignées sur les étoiles, puis moyennées. Étoiles nettes, bruit réduit en √N."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्रेम तारों पर संरेखित, फिर औसत। तारे तीखे रहते हैं, शोर √N से घटता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogrammi allineati sulle stelle, poi mediati. Le stelle restano nitide, il rumore cala come √N."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "星で位置合わせして平均。星はシャープなまま、ノイズは√Nで減少。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kareler yıldızlara göre hizalanır, sonra ortalanır. Yıldızlar net kalır, gürültü √N ile düşer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按星点对齐后平均。星点保持锐利，噪点按√N下降。"
          }
        }
      }
    },
    "Frames stacked": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإطارات المكدّسة"
          }
        },
        "de": {
