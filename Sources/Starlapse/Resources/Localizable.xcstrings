        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سماء هادئة، أو العتبة صارمة جدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhiger Himmel, oder die Schwelle ist zu streng."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cielo tranquilo, o el umbral es demasiado estricto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciel calme, ou seuil trop strict."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत आकाश, या थ्रेशोल्ड बहुत सख़्त है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cielo tranquillo, oppure la soglia è troppo severa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かな空か、しきい値が厳しすぎます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin bir gökyüzü ya da eşik fazla sıkı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天空平静，或阈值过严。"
          }
        }
      }
    },
    "AIM HERE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه هنا"
          }
        },
        "de": {
