---
// App Store link with a campaign token: Apple ties page views, installs and purchases to it
// in App Store Connect › Analytics › Campaigns, and our counter records the same placement
// name, so the two reports line up. The token marks the source, never the visitor.
const APP_STORE_ID = '6801191027';
const PROVIDER_TOKEN = '128499174';
const storeLink = (placement: string) => ({
  href: `https://apps.apple.com/app/apple-store/id${APP_STORE_ID}?pt=${PROVIDER_TOKEN}&ct=site-${placement}&mt=8`,
  target: '_blank',
  rel: 'noopener',
  'data-sda-event': 'app_store_opened',
  'data-sda-placement': placement,
});

const facts = [
  { n: '1 s', t: 'is all an iPhone frame can hold', d: 'So Starlapse stacks: hundreds of one-second frames, aligned on the stars, become one exposure of ten minutes or an hour. Noise falls with every frame.' },
  { n: 'locked', t: 'ISO, shutter, focus, white balance', d: 'Set once, held for the whole session. No exposure creeping up, no autofocus hunting in the dark, no streetlight turning the sky orange.' },
  { n: '0.1°', t: 'focus found on the stars themselves', d: 'The infinity mark is not infinity. The app steps the lens, measures how big the stars come out, and settles on the smallest, the way observatories focus.' },
];

const feats = [
  { k: 'STARS', t: 'Pinpoint stars', d: 'Frames aligned on the sky, so stars stay points through an hour of stacking.' },
  { k: 'TRAILS', t: 'Star trails', d: 'The sky’s rotation drawn as arcs while the ground stays sharp.' },
  { k: 'TIME-LAPSE', t: 'Night time-lapse', d: 'Every frame of the video is its own stack, not one noisy second.' },
  { k: 'METEORS', t: 'Meteor detector', d: 'Watches the sky and keeps a clip of anything that crosses it, placed on the sky and named by its shower.' },
  { k: 'AIM', t: 'Where to point, tonight', d: 'Meteors streak away from the radiant, so the longest trails are 40° off it. Worked out for your place and hour, clear of the Moon.' },
  { k: 'ALERTS', t: 'Good nights, announced', d: 'A reminder on the evening of each shower worth staying up for from where you are. Local, nothing sent.' },
];

const shots = [
  { img: '/img/02-stacking.jpg', cap: 'An hour of light, from one-second frames' },
  { img: '/img/01-aiming.jpg', cap: 'Planets, bright stars, the Milky Way, where to aim' },
  { img: '/img/05-events.jpg', cap: 'This season’s showers, for your latitude' },
  { img: '/img/04-detector.jpg', cap: 'Meteor detector' },
  { img: '/img/03-controls.jpg', cap: 'Manual camera that stays manual' },
];
---
<header class="hero">
  <canvas id="starfield" aria-hidden="true"></canvas>
  <div class="wrap grid">
    <div>
      <span class="kicker left">Long-exposure camera for iPhone</span>
      <h1>The night sky,<br>properly.</h1>
      <p class="lede">An iPhone frame caps at one second. Starlapse stacks hundreds of them into a long exposure, aligned on the stars, and tells you where to point tonight.</p>
      <div class="cta">
        <a class="btn btn-accent" {...storeLink('hero')}>Download on the App Store</a>
        <a class="btn btn-ghost" href="#how">How it works</a>
      </div>
      <p class="note mono">FREE · PRO $4.99 ONCE · NO ACCOUNT · NO ADS</p>
    </div>
    <div class="phone"><img src="/img/02-stacking.jpg" alt="Starlapse stacking the night sky" width="300" height="652" /></div>
  </div>
</header>

<section id="how">
  <div class="wrap">
    <p class="kicker">How it works</p>
    <h2 class="h2">Three facts the app is built around</h2>
    <p class="sub">Each one contradicts something people bring from DSLR astrophotography.</p>
    <div class="facts">
      {facts.map((f) => (
        <div class="fact">
          <div class="n mono">{f.n}</div>
          <h3>{f.t}</h3>
          <p>{f.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <p class="kicker">What it does</p>
    <h2 class="h2">Six ways to photograph the dark</h2>
    <div class="feats">
      {feats.map((f) => (
        <div class="feat">
          <span class="tag mono">{f.k}</span>
          <h3>{f.t}</h3>
          <p>{f.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="shots">
      {shots.map((s) => (
        <figure>
          <img src={s.img} alt={s.cap} loading="lazy" width="240" height="522" />
          <figcaption>{s.cap}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section id="sky" class="band">
  <div class="wrap two">
    <div>
      <p class="kicker left">New in 1.1</p>
      <h2 class="h2 left">Every photo measures your sky</h2>
      <p class="body">The stars in a stack are a light meter. Starlapse finds them in a catalogue of 9,096, compares each with the sky right around it, and reads the darkness the way a Sky Quality Meter does: magnitudes per square arcsecond, a Bortle class, the faintest star your eye could see.</p>
      <p class="body">If you choose to, the reading and the photo go into a dataset for mapping light pollution, with your location rounded to about 10 km. A night-sky globe built from it is next.</p>
    </div>
    <div class="reading mono">
      <div class="row"><span>SKY</span><b>20.8</b><span>MAG/ARCSEC²</span></div>
      <div class="row"><span>BORTLE</span><b>4</b><span>RURAL/SUBURBAN</span></div>
      <div class="row"><span>NAKED EYE</span><b>6.1</b><span>LIMIT</span></div>
      <div class="row"><span>STARS</span><b>140</b><span>MATCHED</span></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <p class="kicker">Honest limits</p>
    <h2 class="h2">What no app can change</h2>
    <ul class="limits">
      <li><b>Aperture is fixed.</b> On iPhone it is a property of the lens. The app shows what each lens gives up and lets you pick.</li>
      <li><b>No background capture.</b> iOS stops the camera when an app leaves the screen. Starlapse keeps the screen on and dims it to red.</li>
      <li><b>You need a tripod.</b> An hour of stacking on a handheld phone is an hour of nothing.</li>
    </ul>
    <div class="cta center">
      <a class="btn btn-accent" {...storeLink('footer')}>Download on the App Store</a>
    </div>
    <p class="note mono center">OPEN SOURCE · <a href="https://github.com/fortunto2/starlapse">GITHUB.COM/FORTUNTO2/STARLAPSE</a></p>
  </div>
</section>

<script>
  // A sky that turns: a few hundred stars, rotating about a pole off the top left, the way
  // a star-trail exposure sees it. Paused for people who ask for less motion.
  const canvas = document.getElementById("starfield") as HTMLCanvasElement | null;
  const context = canvas?.getContext('2d');
  if (canvas && context) {
    const stars = Array.from({ length: 420 }, () => ({
      r: Math.sqrt(Math.random()) * 1.6, a: Math.random() * Math.PI * 2,
      m: Math.pow(Math.random(), 3), hue: Math.random(),
    }));
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let angle = 0;
    const draw = () => {
      const w = (canvas.width = canvas.clientWidth * devicePixelRatio);
      const h = (canvas.height = canvas.clientHeight * devicePixelRatio);
      const px = w * 0.15, py = -h * 0.1, reach = Math.hypot(w, h);
      context.clearRect(0, 0, w, h);
      for (const s of stars) {
        const radius = s.r * reach * 0.8;
        const x = px + Math.cos(s.a + angle) * radius;
        const y = py + Math.sin(s.a + angle) * radius;
        if (x < 0 || y < 0 || x > w || y > h) continue;
        const size = (0.4 + s.m * 1.8) * devicePixelRatio;
        context.fillStyle = s.hue > 0.85 ? 'rgba(255,214,150,.9)' : s.hue < 0.15 ? 'rgba(170,200,255,.9)' : 'rgba(255,255,255,.85)';
        context.globalAlpha = 0.35 + s.m * 0.65;
        context.beginPath(); context.arc(x, y, size, 0, Math.PI * 2); context.fill();
      }
      angle += 0.00025;
      if (!still) requestAnimationFrame(draw);
    };
    draw();
  }
</script>

<style>
  .hero{position:relative;overflow:hidden;padding:72px 0 64px;border-bottom:1px solid var(--line);
    background:radial-gradient(ellipse at 70% 120%,rgba(70,60,140,.35),transparent 60%),#000}
  #starfield{position:absolute;inset:0;width:100%;height:100%}
  .grid{position:relative;display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}
  @media(max-width:820px){.grid{grid-template-columns:1fr}.phone{display:none}}
  .left{text-align:left}
  h1{font-size:clamp(40px,7vw,72px);line-height:1.02;font-weight:800;letter-spacing:-1.5px;margin:14px 0 18px}
  .lede{font-size:19px;color:var(--dim);max-width:30em}
  .cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
  .cta.center{justify-content:center;margin-top:40px}
  .note{font-size:11px;color:var(--dim);margin-top:16px}
  .note.center{text-align:center}
  .note a{color:var(--accent)}
  .phone img{width:100%;max-width:300px;border-radius:36px;border:1px solid var(--line);display:block;margin:0 auto;
    box-shadow:0 30px 80px rgba(0,0,0,.6),0 0 0 8px #0c0d10}
  .facts{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  @media(max-width:820px){.facts{grid-template-columns:1fr}}
  .fact{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:24px}
  .fact .n{font-size:30px;color:var(--accent);font-weight:700}
  .fact h3{font-size:17px;margin:8px 0}
  .fact p,.feat p{color:var(--dim);font-size:15px}
  .band{background:var(--panel);border-block:1px solid var(--line)}
  .feats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:36px}
  @media(max-width:820px){.feats{grid-template-columns:1fr 1fr}}
  @media(max-width:520px){.feats{grid-template-columns:1fr}}
  .feat{border:1px solid var(--line);border-radius:16px;padding:22px;background:#000}
  .tag{font-size:11px;color:var(--accent)}
  .feat h3{font-size:17px;margin:8px 0 6px}
  .shots{display:flex;gap:16px;overflow-x:auto;padding-bottom:12px;scroll-snap-type:x mandatory}
  .shots figure{flex:0 0 220px;scroll-snap-align:start}
  .shots img{width:100%;height:auto;border-radius:22px;border:1px solid var(--line);display:block}
  .shots figcaption{font-size:13px;color:var(--dim);margin-top:10px}
  .two{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center}
  @media(max-width:820px){.two{grid-template-columns:1fr}}
  .h2.left{text-align:left}
  .body{color:var(--dim);font-size:17px;margin-top:16px}
  .reading{border:1px solid var(--line);border-radius:18px;padding:22px;background:#000}
  .row{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:baseline;padding:10px 0;border-bottom:1px solid var(--line);font-size:12px;color:var(--dim)}
  .row:last-child{border-bottom:0}
  .row b{font-size:28px;color:var(--accent)}
  .row span:last-child{text-align:right}
  .limits{list-style:none;max-width:720px;margin:32px auto 0;display:grid;gap:14px}
  .limits li{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px 20px;color:var(--dim)}
  .limits b{color:var(--ink)}
</style>
