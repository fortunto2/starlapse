# Copy to Makefile.local (gitignored) and fill in your own values.
#
#   cp Makefile.local.example Makefile.local
#
# Nothing here belongs in version control: the device identifier names your
# phone, and the coordinates name where you stand at night.

# Apple Developer Team ID used to sign device builds.
# Find it: Xcode → Settings → Accounts → your team, or `security cms -D -i <profile>`.
TEAM := ABCDE12345

# Target device for `make install`. Use the identifier, not the name —
# device names often contain a typographic apostrophe that shell quoting mangles.
# Find it: make device
DEVICE := 00000000-0000-0000-0000-000000000000

# Your observing site, for `make integration`. East longitude positive.
LAT := 28.7
LON := -17.9
